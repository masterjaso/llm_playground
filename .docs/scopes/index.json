{
  "global_excludes": [
    "**/node_modules/**",
    "**/.git/**",
    "**/artifacts/**",
    "**/coverage/**",
    "**/dist/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/*.egg-info/**"
  ],
  "scopes": {
    "root": {
      "description": "Repository root entrypoints and package manifest",
        "include": [
        "README.md",
        "pyproject.toml",
        "AGENTS.md"
      ],
      "exclude": []
    },
    "governance": {
      "description": "Core guidance and routing docs (legacy scope key name retained)",
      "include": [
        ".docs/*.md",
        ".docs/guidance/**/*.md",
        ".docs/scopes/index.json",
        ".docs/scopes/README.md"
      ],
      "exclude": [
        ".docs/features/**",
        ".docs/technical/**"
      ]
    },
    "features": {
      "description": "User-facing feature documentation",
      "include": [
        ".docs/features/**/*.md"
      ],
      "exclude": []
    },
    "technical": {
      "description": "Maintainer technical documentation",
      "include": [
        ".docs/technical/**/*.md"
      ],
      "exclude": []
    },
    "context-hygiene": {
      "description": "Context hygiene standards and scope alignment",
      "include": [
        ".docs/guidance/nsp/**/*.md",
        ".docs/scopes/**",
        ".docs/features/README.md"
      ],
      "exclude": []
    },
    "scripts": {
      "description": "Operational and validation scripts",
      "persona": "platform-engineering",
      "include": [
        "scripts/**/*.py"
      ],
      "exclude": []
    },
    "tooling": {
      "description": "Tooling and package metadata",
      "include": [
        "pyproject.toml",
        "uv.lock",
        "configs/**/*.yaml",
        "configs/**/*.json"
      ],
      "exclude": []
    },
    "security": {
      "description": "Security-sensitive docs and scripts",
      "persona": "security-engineering",
      "include": [
        ".docs/guidance/nsp/stewardship.md",
        "training_data/registry/licenses.yaml"
      ],
      "exclude": []
    },
    "source": {
      "description": "Likely product source roots",
      "persona": "model-research",
      "include": [
        "src/**"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/dist/**",
        "**/coverage/**"
      ]
    },
    "tests": {
      "description": "Likely test roots",
      "persona": "qa-validation",
      "include": [
        "tests/**"
      ],
      "exclude": []
    },
    "training-data": {
      "description": "Source registry, recipes, schemas, tokenizer contracts, and release state",
      "include": [
        "training_data/**"
      ],
      "exclude": [
        "training_data/manifests/shards/**"
      ]
    },
    "docs": {
      "description": "Likely documentation roots",
      "include": [
        "docs/**",
        ".docs/**"
      ],
      "exclude": []
    }
  }
}
