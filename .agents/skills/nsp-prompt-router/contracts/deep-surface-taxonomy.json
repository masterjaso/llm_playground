  "cliModules": [
    {
      "id": "project",
      "primaryOperations": ["setup", "validate", "update", "cleanup", "metrics", "(bare status summary)"],
      "intendedSkillOwner": "nsp-adopt-ezra"
    },
    {
      "id": "knowledge",
      "primaryOperations": ["build", "validate", "view", "views", "inspect", "impact", "select"],
      "intendedSkillOwner": "nsp-insight-berean"
    },
    {
      "id": "work",
      "primaryOperations": ["status", "list", "prepare", "prepare-pr", "close"],
      "intendedSkillOwner": "nsp-build-bezalel"
    },
    {
      "id": "maintain",
      "primaryOperations": ["check", "plan", "apply-safe", "status", "close"],
      "intendedSkillOwner": "nsp-maintain-steward"
    },
    {
      "id": "env",
      "primaryOperations": ["doctor", "install", "uninstall", "harness", "capability", "migrate"],
      "intendedSkillOwner": null
    }
  ],
  "cliVisibility": {
    "levels": ["normal", "module", "advanced"],
    "rootHelpExposes": ["project", "knowledge", "work", "maintain", "env"],
    "advancedDiscovery": ["_nsp --help --all", "_nsp <module> --help --advanced"]
  },
  "domainLanguage": {
    "canonicalRoot": ".docs/domain",
    "authorityLifecycle": ["inferred", "proposed", "canonical", "deprecated"],
    "semanticOwner": "nsp-insight-berean",
    "cliSemanticMutationsAllowed": false,
    "admissionPolicy": "Codify only project-specific or consequential terms; prefer fewer higher-value concepts; never silently promote inferred candidates to canonical."
  },
  "personas": {
    "categoryRenameFrom": "Domain personas",
    "categoryRenameTo": "Project Personas",
    "boundary": "Domain Language defines what something means; Personas define who owns, routes, reviews, or validates work involving it."
  },
  "knowledgeFabric": {
    "entryCommand": "knowledge view",
    "lenses": [
      "overview",
      "architecture",
      "feature",
      "code",
      "domain",
      "governance",
      "ownership",
      "risk",
      "review",
      "repair"
    ],
    "focusFlag": "--focus",
    "unifyExperienceNotStorage": true
  },
  "executionDisciplines": {
    "verificationBeforeClaim": true,
    "genesisInquiryDepths": ["none", "compact", "deep"],
    "exhaustivePrReview": true,
    "adaptiveTestFirst": true,
    "workspaceIsolation": {
      "optional": true,
      "mandatory": false,
      "capabilityBased": true
    }
  },
  "durableState": {
    "beaconPath": ".nsp/project.json",
    "beaconFields": [
      "appliedNspVersion",
      "appliedAt",
      "agenticReconciliationVersion",
      "agenticReconciliationAt",
      "agenticReconciliationReport"
    ],
    "metricsPath": ".nsp/metrics.json",
    "capabilitiesPath": ".nsp/capabilities.json",
    "forbiddenDurablePaths": [".nsp/state", ".nsp/config"]
  },
  "compatibility": {
    "preserveOldCliRootsAsAliases": true,
    "preserveProvenanceEnvelope": true,
    "semanticJudgmentByCli": false
  }
}
