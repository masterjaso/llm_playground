  "routingRelationships": [
    {
      "from": "nsp-prompt-router",
      "to": "nsp-acceptance-prover",
      "relationship": "qualification",
      "condition": "Acceptance / UAT / completed-work qualification"
    },
    {
      "from": "nsp-build-bezalel",
      "to": "nsp-acceptance-prover",
      "relationship": "qualification",
      "condition": "completed controlled work requires independent acceptance proof"
    },
    {
      "from": "nsp-acceptance-prover",
      "to": "nsp-build-bezalel",
      "relationship": "repair-routing",
      "condition": "incomplete implementation failures route through controlled acceptance-repair"
    },
    {
      "from": "nsp-acceptance-prover",
      "to": "nsp-debug-watchman",
      "relationship": "repair-routing",
      "condition": "behavioral defects and regressions route through controlled acceptance-repair"
