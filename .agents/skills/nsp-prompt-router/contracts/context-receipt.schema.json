{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nehemiah-steward-protocol.local/contracts/context-receipt.schema.json",
  "title": "NSP Assistant Context Receipt",
  "type": "object",
  "required": ["source", "authority", "confidence", "reviewStatus", "deterministicFacts", "inferredRecommendation"],
  "properties": {
    "source": { "const": "assistant" },
    "authority": { "const": "model-inferred" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "reviewStatus": { "const": "unreviewed" },
    "deterministicFacts": {
      "type": "object",
      "description": "References to _nsp context select facts, selected doc paths, graph IDs, and validator output used as evidence."
    },
    "inferredRecommendation": {
      "type": "object",
      "required": ["classification", "persona", "primaryScopes", "selectedDocs", "contextExclusions", "scopeExpansionRule", "handoffExpectations"],
      "properties": {
        "classification": { "type": "string" },
        "persona": { "type": "string" },
        "supportingPersonas": { "type": "array", "items": { "type": "string" } },
        "primaryScopes": { "type": "array", "items": { "type": "string" } },
        "selectedDocs": { "type": "array", "items": { "type": "string" } },
        "notLoaded": { "type": "array", "items": { "type": "string" } },
        "riskFlags": { "type": "array", "items": { "type": "string" } },
        "validationCommands": { "type": "array", "items": { "type": "string" } },
        "contextExclusions": { "type": "array", "items": { "type": "string" } },
        "scopeExpansionRule": { "type": "string" },
        "handoffExpectations": { "type": "array", "items": { "type": "string" } },
        "nextSteps": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nodeIds": { "type": "array", "items": { "type": "string" } },
    "edgeIds": { "type": "array", "items": { "type": "string" } }
  }
}
