{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nehemiah-steward-protocol.local/contracts/epic-state.schema.json",
  "title": "NSP Epic Ralph State (STATE.json)",
  "description": "Resumable epic state maintained by nsp-epic-execution under .nsp/artifacts/tmp/ralph/<epic-id>/STATE.json.",
  "type": "object",
  "oneOf": [
    {
      "required": ["schemaVersion", "kind", "epicId", "runId", "currentPhase", "workStateRef"],
      "properties": {
        "schemaVersion": { "const": 1 }, "kind": { "const": "managed-epic" },
        "epicId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "runId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "currentPhase": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
        "workStateRef": { "type": "string", "pattern": "^\\.nsp/artifacts/runs/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/work/capsules/[A-Za-z0-9][A-Za-z0-9._-]{0,79}/STATE\\.json$" }
      },
      "additionalProperties": false,
      "description": "Pointer only. Runtime checks matching run/epic/phase and resolves immutable capsule registration; pointer fields do not establish acceptance."
    },
    { "required": ["schemaVersion", "epicId", "currentPhase", "phaseStatuses", "lastUpdated"], "not": { "required": ["kind"] } }
  ],
  "properties": {
    "schemaVersion": { "type": "number" },
    "epicId": { "type": "string" },
    "repo": { "type": "string" },
    "baseBranch": { "type": "string" },
    "baselineCommit": { "type": "string" },
    "workBranch": { "type": "string" },
    "currentPhase": { "type": "string" },
    "currentWorkItem": { "type": ["string", "null"] },
    "phaseStatuses": {
      "type": "object",
      "additionalProperties": {
        "enum": ["not-started", "planned", "in-progress", "blocked", "implemented", "validating", "done", "deferred", "superseded"]
      }
    },
    "workItems": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "status"],
        "properties": {
          "phase": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["not-started", "planned", "in-progress", "blocked", "implemented", "validating", "done", "deferred", "superseded"] }
        }
      }
    },
    "validationLedgerPath": { "type": "string" },
    "decisionLogPath": { "type": "string" },
    "riskRegisterPath": { "type": "string" },
    "lastAgentHandoff": { "type": "string" },
    "nextAgentInstructions": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "openRisks": { "type": "array", "items": { "type": "string" } },
    "lastUpdated": { "type": "string" }
  }
}
