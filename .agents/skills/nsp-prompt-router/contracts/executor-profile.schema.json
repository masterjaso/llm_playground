{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nehemiah-steward-protocol.local/contracts/executor-profile.schema.json",
  "title": "NSP Executor Profile",
  "description": "Configuration-driven executor selection profile with no model/provider fields.",
  "type": "object",
  "required": ["id", "adapter", "priority"],
  "properties": {
    "id": { "type": "string" },
    "adapter": { "type": "string" },
    "command": { "type": "string" },
    "args": { "type": "array", "items": { "type": "string" } },
    "priority": { "type": "number" },
    "capabilityOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["supported", "unsupported"] }
        },
        "additionalProperties": false
      }
    },
    "workspacePolicy": {
      "type": "string",
      "enum": ["isolated-worktree", "inplace", "read-only"]
    },
    "allowedInstallModes": {
      "type": "array",
      "items": { "type": "string", "enum": ["global", "local-only"] }
    },
    "healthy": { "type": "boolean" },
    "available": { "type": "boolean" }
  },
  "additionalProperties": false
}
