{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nehemiah-steward-protocol.local/contracts/prediction-contract.schema.json",
  "title": "NSP Prediction Contract",
  "description": "Standalone bounded prediction artifact. Acceptance criteria remain outside this contract.",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "nspProvenance", "runId", "phaseOrPivId", "mode",
    "primaryHypothesis", "expectedChanges", "expectedObservations", "invariants",
    "contradictionConditions", "evidenceRefs", "confidence", "mismatchAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "prediction-contract" },
    "nspProvenance": { "$ref": "#/$defs/provenance" },
    "runId": { "$ref": "#/$defs/identifier" },
    "phaseOrPivId": { "$ref": "#/$defs/identifier" },
    "mode": { "enum": ["compact", "expanded"] },
    "primaryHypothesis": { "$ref": "#/$defs/string600" },
    "expectedChanges": { "$ref": "#/$defs/list8x240" },
    "expectedObservations": { "$ref": "#/$defs/list5x300" },
    "invariants": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/string300" } },
    "contradictionConditions": { "$ref": "#/$defs/list5x300" },
    "evidenceRefs": { "$ref": "#/$defs/evidenceRefs" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "mismatchAction": { "enum": ["continue", "inspect", "revise-plan", "abandon-hypothesis"] },
    "alternatives": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "diagnosticProbes": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/string300" } }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "compact" } }, "required": ["mode"] },
      "then": { "not": { "anyOf": [{ "required": ["alternatives"] }, { "required": ["diagnosticProbes"] }] } }
    },
    {
      "if": { "properties": { "mode": { "const": "expanded" } }, "required": ["mode"] },
      "then": { "required": ["alternatives", "diagnosticProbes"] }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^(?!\\.{1,2}$)[a-z0-9][a-z0-9._-]*$" },
    "string240": { "type": "string", "minLength": 1, "maxLength": 240 },
    "string300": { "type": "string", "minLength": 1, "maxLength": 300 },
    "string600": { "type": "string", "minLength": 1, "maxLength": 600 },
    "list8x240": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/string240" } },
    "list5x300": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/string300" } },
    "evidenceRefs": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/string240" } },
    "provenance": {
      "type": "object",
      "required": ["schemaVersion", "source", "semanticJudgmentByCli", "authority", "reviewStatus", "intendedSkillOwner", "modelProviderRequired"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "source": { "const": "deterministic-cli" },
        "semanticJudgmentByCli": { "const": false },
        "authority": { "enum": ["deterministic-validator", "deterministic-parser", "heuristic", "safe-repair-candidate"] },
        "reviewStatus": { "enum": ["reviewed", "unreviewed"] },
        "intendedSkillOwner": { "type": ["string", "null"] },
        "modelProviderRequired": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
