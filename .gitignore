__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
env/
.env.*
.env
runs/*/source/
runs/*/text-checkpoint/
runs/*/artifacts/*.gguf
runs/*/artifacts/*.gguf.json
runs/*/capture/*.json
*.publishing

# FlashMini experiment artifacts (large data, checkpoints, logs)
data/
runs/
checkpoints/
reports/flashmini/*.jsonl
reports/flashmini/eval/

# Global-backed repos keep only the project beacon under .nsp/; runtime lives in NSP global homes.
!.nsp/
!.nsp/project.json
!.nsp/artifacts/
.nsp/artifacts/**
!.nsp/artifacts/.gitkeep
!.nsp/metrics.json
!.nsp/capabilities.json

# FlashMini data v4 runtime/cache (never bulk data)
.cache/
*.parquet
training_data/manifests/shards/
training_data/manifests/build_state*.json
training_data/manifests/corpus_manifest*.json
